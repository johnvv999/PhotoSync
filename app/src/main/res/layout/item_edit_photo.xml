<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="@null" />

        <!-- Sits over the photo's top-left corner, on a translucent chip so it
             stays visible against a light or dark image. Hidden unless the
             screen is in a selection mode. -->
        <CheckBox
            android:id="@+id/selectCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:paddingHorizontal="6dp"
            android:background="#C8FFFFFF"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/fileNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="4dp"
        android:textSize="13sp"
        android:textColor="#9AA0A6" />

    <LinearLayout
        android:id="@+id/locationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <!-- White text needs something dark behind it: on the light window
             background it would be invisible. The navy chip is the same colour
             as the tab bar, and the hint is lightened to stay legible on it. -->
        <EditText
            android:id="@+id/locationInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/location_hint"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/bg_location_field"
            android:textColor="@android:color/white"
            android:textColorHint="#B8C9DC"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:autofillHints="" />

        <Button
            android:id="@+id/saveLocationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/btn_3d"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:text="@string/save_location" />

    </LinearLayout>

    <!-- This page shows through to the activity's navy background, so every
         colour here has to be a light one. #1A73E8 and the default text colour
         are near-invisible against it. -->
    <TextView
        android:id="@+id/infoLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:padding="4dp"
        android:text="@string/info_link"
        android:textColor="#8AB4F8"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/infoResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:textColor="#E8EEF4"
        android:visibility="gone" />

</LinearLayout>
