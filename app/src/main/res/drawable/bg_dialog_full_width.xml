<?xml version="1.0" encoding="utf-8"?>
<!-- The dialog theme's own background is an inset drawable, which holds the
     window off the screen edges no matter how wide the window is asked to be.
     This is the same rounded panel without the inset, so a full-width dialog
     actually reaches the sides. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/white" />
    <corners android:radius="8dp" />

</shape>
